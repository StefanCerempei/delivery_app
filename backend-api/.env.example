# Copiază acest fișier ca backend-api/.env pentru rulare locală.
# Pe Hostinger NU urci .env: pui aceleași variabile în hPanel → aplicația → Environment variables.

# Doar local! Pe Hostinger nu seta NODE_ENV (sau pune production).
NODE_ENV=development

# Baza de date MySQL (pe Hostinger, DB_HOST este de obicei localhost)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_reloq
DB_USER=u123456789_reloq
DB_PASSWORD=

# Cheie secretă pentru sesiuni: minim 32 de caractere aleatorii.
# Generează una cu: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Contul de dispecer creat automat la prima pornire (parola: minim 10 caractere)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Opțional — plăți cu cardul prin Stripe (cheia secretă începe cu sk_test_ sau sk_live_)
STRIPE_SECRET_KEY=
CURRENCY=usd

# Opțional — emailuri (confirmări pentru clienți, alerte de comandă nouă)
# Gmail (test): SMTP_HOST=smtp.gmail.com, SMTP_USER=adresa@gmail.com, SMTP_PASS=App Password (16 caractere)
# Domeniu Hostinger: SMTP_HOST=smtp.hostinger.com, SMTP_USER=info@reloqmove.com, SMTP_PASS=parola căsuței
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Expeditorul afișat (implicit: SMTP_USER)
MAIL_FROM=
# Unde vin alertele de comandă nouă (implicit: SMTP_USER). Mai multe: separate prin virgulă
ORDER_NOTIFY_EMAIL=
# Adresa publică a aplicației, pentru butoanele din emailuri (ex. https://ivory-kudu-288022.hostingersite.com)
APP_URL=
