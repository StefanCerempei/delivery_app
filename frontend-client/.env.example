# Copiază ca frontend-client/.env pentru rulare locală. Pe Hostinger le pui în Environment variables.
# Variabilele VITE_* ajung în codul public din browser: pune aici DOAR chei publice.

# Cheia PUBLICĂ Stripe (pk_test_... sau pk_live_...). Necesară doar dacă activezi plata cu cardul.
VITE_STRIPE_PUBLISHABLE_KEY=

# Lasă gol: API-ul e pe același domeniu. Completează doar dacă backend-ul e pe alt domeniu.
VITE_API_URL=
