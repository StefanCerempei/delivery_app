{
  "name": "reloq",
  "private": true,
  "version": "1.0.0",
  "description": "Reloq — aplicația de mutări și livrări (API Express + frontend React)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm --prefix frontend-client install --include=dev && npm --prefix frontend-client run build",
    "start": "node backend-api/server.js",
    "dev:api": "node --watch --env-file=backend-api/.env backend-api/server.js",
    "dev:web": "npm --prefix frontend-client run dev"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "stripe": "^17.5.0",
    "zod": "^3.24.1"
  }
}
